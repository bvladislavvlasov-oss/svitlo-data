name: light

on:
  schedule:
    - cron: "*/30 * * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  fetch:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install dtek-blackout-client==0.1.12
      - run: playwright install --with-deps chromium
      - run: python fetch_light.py
        env:
          DTEK_CITY: ${{ secrets.DTEK_CITY }}
          DTEK_STREET: ${{ secrets.DTEK_STREET }}
          DTEK_GROUP: GPV2.2
      - run: |
          git config user.name "light-bot"
          git config user.email "light-bot@users.noreply.github.com"
          git add light.json
          git diff --cached --quiet || (git commit -m "light update" && git push)
